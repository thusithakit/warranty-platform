{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.warranty.local/events/event-envelope-v1.schema.json",
  "title": "Warranty Platform Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "aggregateId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  }
}

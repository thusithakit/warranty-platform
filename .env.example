.env.example# Local development only. Replace before use; never commit .env.
COMPOSE_PROJECT_NAME=warranty-platform

# PostgreSQL - separate containers and credentials
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

USER_DB_NAME=user_db
USER_DB_USER=user_app
USER_DB_PASSWORD=change-me-user-db

PURCHASE_DB_NAME=purchase_db
PURCHASE_DB_USER=purchase_app
PURCHASE_DB_PASSWORD=change-me-purchase-db

WARRANTY_DB_NAME=warranty_db
WARRANTY_DB_USER=warranty_app
WARRANTY_DB_PASSWORD=change-me-warranty-db

DOCUMENT_DB_NAME=document_db
DOCUMENT_DB_USER=document_app
DOCUMENT_DB_PASSWORD=change-me-document-db

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me-notification-db

ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=change-me-analytics-db

AI_DB_NAME=ai_db
AI_DB_USER=ai_app
AI_DB_PASSWORD=change-me-ai-db

# Keycloak development bootstrap
KEYCLOAK_ADMIN=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DEV_USERNAME=demo-user
KEYCLOAK_DEV_PASSWORD=change-me-demo-user
KEYCLOAK_DEV_EMAIL=demo@example.local

# Gateway / OIDC
GATEWAY_PORT=8080
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/warranty-platform
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/warranty-platform/protocol/openid-connect/certs

# Kafka
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8090
